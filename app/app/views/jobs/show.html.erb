<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8 text-center">

      <h2 class="mb-4">Processing complete</h2>
      <p class="text-muted mb-4">Job <%= @job_id %></p>

      <%= link_to "Download JSON", download_job_path(@job_id), class: "btn btn-success" %>
      <%= button_to "Delete", job_path(@job_id), method: :delete,
            class: "btn btn-outline-danger", form: { class: "d-inline" } %>

      <p class="mt-4"><%= link_to "Start another job", root_path %></p>

    </div>
  </div>
</div>